<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/mfa/factor/oksigeniaaty/db" VERSION="20261121" COMMENT="XMLDB file for factor_oksigeniaaty"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="factor_oksigeniaaty_req" COMMENT="Each request to approve a sign-in from the phone">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Who is signing in"/>
        <FIELD NAME="sid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 of the browser session that waits for the answer"/>
        <FIELD NAME="code" TYPE="int" LENGTH="2" NOTNULL="true" SEQUENCE="false" COMMENT="The number shown on the sign-in screen"/>
        <FIELD NAME="choices" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="The numbers offered on the phone, the right one among them, separated by commas"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, approved, denied, wrong, expired or used"/>
        <FIELD NAME="device" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Browser and system of the sign-in, as the phone shows them"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="true" SEQUENCE="false" COMMENT="Address the sign-in came from"/>
        <FIELD NAME="via" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Where it was answered: app, web, telegram or whatsapp"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeexpires" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeanswered" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sid" UNIQUE="false" FIELDS="sid"/>
        <INDEX NAME="status-timecreated" UNIQUE="false" FIELDS="status, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="factor_oksigeniaaty_enrol" COMMENT="Each code to register a phone, shown on a page that passed another factor">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The person whose phone it registers"/>
        <FIELD NAME="codehash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 of the code; the code itself is only in the QR and the link"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, done or expired"/>
        <FIELD NAME="toolmfaid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The phone registered with it, a row of tool_mfa"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeexpires" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="codehash" UNIQUE="false" FIELDS="codehash"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="factor_oksigeniaaty_codes" COMMENT="Each recovery code of a person, for the day the phone is lost; only its hash">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Whose code it is"/>
        <FIELD NAME="codehash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="HMAC-SHA256 of the person and the code; the code itself is only on the person's paper"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When it passed the factor, or 0 while unused"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="codehash" UNIQUE="false" FIELDS="codehash"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
