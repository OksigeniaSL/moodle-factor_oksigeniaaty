{{!
    @template factor_oksigeniaaty/mobile_approve

    The request in the app: who is signing in and from where, the three numbers and «It was not me»; or what happened.
    Angular reads double braces, so Mustache here uses <% %>.

    Example context (json):
    {
        "pending": true,
        "requestid": 7,
        "who": "Someone is signing in to Example School with your account.",
        "where": "Chrome on Windows, at 9:41",
        "left": "2 minutes left to answer.",
        "nobody": "Tap a number only if it is you signing in now. Nobody at the centre will ask you to tap one.",
        "choices": [{"value": "42"}, {"value": "17"}, {"value": "85"}],
        "message": "",
        "title": "",
        "changepassword": "",
        "approved": false
    }
}}
{{=<% %>=}}
<div class="ion-padding factor-oksigeniaaty-app">
<%#pending%>
    <p><%who%></p>
    <p><strong><%where%></strong></p>
    <ng-container *ngIf="oksigeniaatyEnrolled">
    <p class="ion-margin-top"><strong><%#str%>approve:pick, factor_oksigeniaaty<%/str%></strong> <%left%></p>
    <p><strong><%nobody%></strong></p>
    <ion-grid>
        <ion-row>
<%#choices%>
            <ion-col>
                <ion-button expand="block" size="large" [disabled]="oksigeniaatyBusy"
                    (click)="oksigeniaatyAnswer(<%requestid%>, '<%value%>')"><%value%></ion-button>
            </ion-col>
<%/choices%>
        </ion-row>
    </ion-grid>
    <p class="ion-text-center"><small><%#str%>approve:pickhint, factor_oksigeniaaty<%/str%></small></p>
    <div class="ion-padding-top ion-margin-top">
        <ion-button expand="block" fill="outline" color="danger" [disabled]="oksigeniaatyBusy"
            (click)="oksigeniaatyAnswer(<%requestid%>, 'deny')"><%#str%>approve:deny, factor_oksigeniaaty<%/str%></ion-button>
    </div>
    <ng-container *ngIf="oksigeniaatyFailed"><p class="ion-text-center"><%#str%>approve:failed, factor_oksigeniaaty<%/str%></p></ng-container>
    </ng-container>
    <ng-container *ngIf="!oksigeniaatyEnrolled"><p><%#str%>approve:notenrolled, factor_oksigeniaaty<%/str%></p></ng-container>
<%/pending%>
<%^pending%>
    <h2><%title%></h2>
    <p><%message%></p>
<%#changepassword%>
    <ion-button expand="block" core-link capture="false" inApp="true" href="<%changepassword%>"><%#str%>approve:changepassword, factor_oksigeniaaty<%/str%></ion-button>
<%/changepassword%>
<%/pending%>
</div>
