{{!
    @template factor_oksigeniaaty/mobile_approve

    The request in the app: who is signing in and from where, the three numbers and «It was not me»; or what happened.
    Angular reads double braces, so Mustache here uses <% %>.

    Example context (json):
    {
        "pending": true,
        "requestid": 7,
        "who": "Someone is signing in to Example School with your account.",
        "where": "Chrome on Windows, at 9:41",
        "choices": [{"value": "42"}, {"value": "17"}, {"value": "85"}],
        "message": "",
        "changepassword": "",
        "approved": false
    }
}}
{{=<% %>=}}
<div class="ion-padding factor-oksigeniaaty-app">
<%#pending%>
    <h2><%#str%>approve:title, factor_oksigeniaaty<%/str%></h2>
    <p><%who%></p>
    <p><strong><%where%></strong></p>
    <p><%#str%>approve:pick, factor_oksigeniaaty<%/str%></p>
    <ion-grid>
        <ion-row>
<%#choices%>
            <ion-col>
                <ion-button expand="block" size="large" core-site-plugins-call-ws name="factor_oksigeniaaty_answer"
                    [params]="{requestid: <%requestid%>, choice: '<%value%>'}" [preSets]="{getFromCache: 0, saveToCache: 0}"
                    refreshOnSuccess="true"><%value%></ion-button>
            </ion-col>
<%/choices%>
        </ion-row>
    </ion-grid>
    <ion-button expand="block" fill="outline" color="danger" core-site-plugins-call-ws name="factor_oksigeniaaty_answer"
        [params]="{requestid: <%requestid%>, choice: 'deny'}" [preSets]="{getFromCache: 0, saveToCache: 0}"
        refreshOnSuccess="true"><%#str%>approve:deny, factor_oksigeniaaty<%/str%></ion-button>
<%/pending%>
<%^pending%>
    <h2><%#approved%><%#str%>approve:donetitle, factor_oksigeniaaty<%/str%><%/approved%><%^approved%><%#str%>approve:title, factor_oksigeniaaty<%/str%><%/approved%></h2>
    <p><%message%></p>
<%#changepassword%>
    <ion-button expand="block" core-link capture="false" inApp="true" href="<%changepassword%>"><%#str%>approve:changepassword, factor_oksigeniaaty<%/str%></ion-button>
<%/changepassword%>
<%/pending%>
</div>
