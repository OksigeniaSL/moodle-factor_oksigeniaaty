{{!
    @template factor_oksigeniaaty/mobile_enrol

    In the app: this phone is being registered to approve sign-ins, it is, or it could not be. Angular reads double
    braces, so Mustache here uses <% %>; the state is the script's.

    Example context (json):
    {
    }
}}
{{=<% %>=}}
<div class="ion-padding">
    <h2><%#str%>enrol:title, factor_oksigeniaaty<%/str%></h2>
    <ng-container *ngIf="oksigeniaatyState === 'working'"><p><ion-spinner name="dots"></ion-spinner> <%#str%>enrol:working, factor_oksigeniaaty<%/str%></p></ng-container>
    <ng-container *ngIf="oksigeniaatyState === 'done'">
        <p><strong><%#str%>enrol:done, factor_oksigeniaaty<%/str%></strong></p>
        <p><%#str%>enrol:donehint, factor_oksigeniaaty<%/str%></p>
    </ng-container>
    <ng-container *ngIf="oksigeniaatyState === 'failed'"><p><%#str%>enrol:failed, factor_oksigeniaaty<%/str%></p></ng-container>
</div>
