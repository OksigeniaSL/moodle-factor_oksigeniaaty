{{!
    @template factor_oksigeniaaty/enrol

    Where the setup QR leads when read with the phone's camera: open it in the app, which registers the phone.

    Example context (json):
    {
        "title": "Register this phone",
        "applink": "moodlemobile://link=https://example.com/admin/tool/mfa/factor/oksigeniaaty/enrol.php?c=x"
    }
}}
<div class="factor-oksigeniaaty-stopped">
    <h2>{{title}}</h2>
    {{#applink}}
    <p>{{#str}} enrolpage:intro, factor_oksigeniaaty {{/str}}</p>
    <p><a class="btn btn-primary" href="{{applink}}">{{#str}} enrolpage:open, factor_oksigeniaaty {{/str}}</a></p>
    <p>{{#str}} enrolpage:noapp, factor_oksigeniaaty {{/str}}</p>
    {{/applink}}
    {{^applink}}
    <p>{{#str}} enrolpage:nocode, factor_oksigeniaaty {{/str}}</p>
    {{/applink}}
</div>
