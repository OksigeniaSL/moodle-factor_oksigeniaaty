{{!
    @template factor_oksigeniaaty/accesses

    «Your accesses»: the phones and chats that approve the person's sign-ins, each with a way to take it away, and the
    sign-ins that asked for approval lately.

    Example context (json):
    {
        "phones": [{"id": 4, "name": "Pixel 8", "since": "21/11/26", "lastused": "22/11/26, 08:14",
            "confirm": "Pixel 8 will no longer approve your sign-ins."}],
        "chats": [{"id": 7, "name": "Telegram · Ana", "since": "21/11/26"}],
        "chatsupported": true,
        "history": [
            {"when": "22/11/26, 08:13", "device": "Chrome on Windows", "outcome": "Approved", "via": "in the app",
                "approved": true, "stopped": false, "waiting": false},
            {"when": "21/11/26, 23:02", "device": "Firefox on Linux", "outcome": "Stopped with «Not me»",
                "via": "on Telegram", "approved": false, "stopped": true, "waiting": false}
        ],
        "days": 30,
        "addurl": "https://example.com/admin/tool/mfa/action.php?action=setup&factor=oksigeniaaty",
        "removephoneurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/removephone.php",
        "unlinkurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/unlinkchat.php",
        "sesskey": "x",
        "passwordurl": "https://example.com/login/change_password.php",
        "recovery": {"made": "22/11/26", "lefttext": "9 of 10 left, made on 22/11/26.", "lastused": "22/11/26, 09:40",
            "createurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/codes.php"}
    }
}}
<div class="factor-oksigeniaaty-accesses">
    <section class="factor-oksigeniaaty-accesses-phones mb-4" aria-labelledby="factor-oksigeniaaty-phones">
        <h3 id="factor-oksigeniaaty-phones">{{#str}} accesses:phones, factor_oksigeniaaty {{/str}}</h3>
        {{#phones.0}}
        <ul class="list-unstyled">
            {{#phones}}
            <li class="mb-3">
                <strong>{{name}}</strong>
                <br><small>{{#str}} accesses:since, factor_oksigeniaaty, {{since}} {{/str}} ·
                {{#lastused}}{{#str}} accesses:lastused, factor_oksigeniaaty, {{lastused}} {{/str}}{{/lastused}}
                {{^lastused}}{{#str}} accesses:neverused, factor_oksigeniaaty {{/str}}{{/lastused}}</small>
                <form method="post" action="{{removephoneurl}}" class="mt-1">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="id" value="{{id}}">
                    <button type="submit" class="btn btn-outline-danger btn-sm"
                        data-modal="confirmation" data-modal-type="delete"
                        data-modal-title-str='["accesses:removephone", "factor_oksigeniaaty"]'
                        data-modal-content="{{confirm}}"
                        data-modal-yes-button-str='["accesses:removephone", "factor_oksigeniaaty"]'>
                        {{#str}} accesses:removephone, factor_oksigeniaaty {{/str}}
                    </button>
                </form>
            </li>
            {{/phones}}
        </ul>
        {{/phones.0}}
        {{^phones.0}}
        <p>{{#str}} accesses:nophones, factor_oksigeniaaty {{/str}}</p>
        {{/phones.0}}
        <p><a class="btn btn-secondary" href="{{addurl}}">{{#str}} accesses:addphone, factor_oksigeniaaty {{/str}}</a></p>
    </section>
    {{#chats.0}}
    <section class="factor-oksigeniaaty-accesses-chats mb-4" aria-labelledby="factor-oksigeniaaty-chats">
        <h3 id="factor-oksigeniaaty-chats">{{#str}} accesses:chats, factor_oksigeniaaty {{/str}}</h3>
        <ul class="list-unstyled">
            {{#chats}}
            <li class="mb-3">
                <strong>{{name}}</strong>
                <br><small>{{#str}} accesses:chatsince, factor_oksigeniaaty, {{since}} {{/str}}</small>
                <form method="post" action="{{unlinkurl}}" class="mt-1">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="id" value="{{id}}">
                    <input type="hidden" name="back" value="accesses">
                    <button type="submit" class="btn btn-outline-danger btn-sm">{{#str}} setup:remove, factor_oksigeniaaty {{/str}}</button>
                </form>
            </li>
            {{/chats}}
        </ul>
    </section>
    {{/chats.0}}
    {{#recovery}}
    <section class="factor-oksigeniaaty-accesses-recovery mb-4" aria-labelledby="factor-oksigeniaaty-recovery">
        <h3 id="factor-oksigeniaaty-recovery">{{#str}} recovery:title, factor_oksigeniaaty {{/str}}</h3>
        <p>{{#str}} recovery:intro, factor_oksigeniaaty {{/str}}</p>
        {{#made}}
        <p>{{lefttext}}
        {{#lastused}}<br><small>{{#str}} recovery:lastused, factor_oksigeniaaty, {{lastused}} {{/str}}</small>{{/lastused}}</p>
        <form method="post" action="{{createurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-secondary"
                data-modal="confirmation"
                data-modal-title-str='["recovery:createnew", "factor_oksigeniaaty"]'
                data-modal-content-str='["recovery:createnewconfirm", "factor_oksigeniaaty"]'
                data-modal-yes-button-str='["recovery:createnew", "factor_oksigeniaaty"]'>
                {{#str}} recovery:createnew, factor_oksigeniaaty {{/str}}
            </button>
        </form>
        {{/made}}
        {{^made}}
        <p>{{#str}} recovery:none, factor_oksigeniaaty {{/str}}</p>
        <form method="post" action="{{createurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-secondary">{{#str}} recovery:create, factor_oksigeniaaty {{/str}}</button>
        </form>
        {{/made}}
    </section>
    {{/recovery}}
    <section class="factor-oksigeniaaty-accesses-history" aria-labelledby="factor-oksigeniaaty-history">
        <h3 id="factor-oksigeniaaty-history">{{#str}} accesses:history, factor_oksigeniaaty {{/str}}</h3>
        {{#history.0}}
        <p>{{#str}} accesses:historyintro, factor_oksigeniaaty, {{days}} {{/str}}</p>
        <ul class="list-unstyled">
            {{#history}}
            <li class="mb-2{{#stopped}} text-danger{{/stopped}}">
                <strong>{{when}}</strong> · {{device}}
                <br><small>{{outcome}}{{#via}} {{via}}{{/via}}</small>
            </li>
            {{/history}}
        </ul>
        {{#passwordurl}}
        <p><a href="{{passwordurl}}">{{#str}} approve:changepassword, factor_oksigeniaaty {{/str}}</a></p>
        {{/passwordurl}}
        {{/history.0}}
        {{^history.0}}
        <p>{{#str}} accesses:nohistory, factor_oksigeniaaty, {{days}} {{/str}}</p>
        {{/history.0}}
    </section>
</div>
