{{!
    @template factor_oksigeniaaty/approve

    The request on the web: who is signing in and from where, the three numbers and «It was not me»; or what happened.

    Example context (json):
    {
        "pending": true,
        "requestid": 7,
        "who": "Someone is signing in to Example School with your account.",
        "where": "Chrome on Windows, at 9:41",
        "left": "2 minutes left to answer.",
        "nobody": "Nobody at the centre will ask you to tap a number. If someone does, tap «Not me».",
        "choices": [{"value": "42"}, {"value": "17"}, {"value": "85"}],
        "formurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/approve.php",
        "sesskey": "x",
        "message": "",
        "changepassword": "",
        "approved": false
    }
}}
<div class="factor-oksigeniaaty-approve">
    {{#pending}}
    <p>{{who}}</p>
    <p><strong>{{where}}</strong></p>
    <p>{{#str}} approve:pick, factor_oksigeniaaty {{/str}} {{left}}</p>
    <p class="factor-oksigeniaaty-nobody"><strong>{{nobody}}</strong></p>
    <div class="factor-oksigeniaaty-choices">
        {{#choices}}
        <form method="post" action="{{formurl}}">
            <input type="hidden" name="r" value="{{requestid}}">
            <input type="hidden" name="choice" value="{{value}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-primary factor-oksigeniaaty-choice">{{value}}</button>
        </form>
        {{/choices}}
    </div>
    <form method="post" action="{{formurl}}">
        <input type="hidden" name="r" value="{{requestid}}">
        <input type="hidden" name="choice" value="deny">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn btn-outline-danger w-100">{{#str}} approve:deny, factor_oksigeniaaty {{/str}}</button>
    </form>
    {{/pending}}
    {{^pending}}
    <p role="status">{{message}}</p>
    {{#changepassword}}
    <p><a class="btn btn-primary" href="{{changepassword}}">{{#str}} approve:changepassword, factor_oksigeniaaty {{/str}}</a></p>
    {{/changepassword}}
    {{/pending}}
</div>
