{{!
    @template factor_oksigeniaaty/stopped

    The sign-in stopped from the phone, with the way back in.

    Example context (json):
    {
        "title": "Sign-in stopped",
        "message": "This sign-in was stopped from the phone. Nobody got in.",
        "loginurl": "https://example.com/login/index.php"
    }
}}
<div class="factor-oksigeniaaty-stopped">
    <h2>{{title}}</h2>
    <p role="status">{{message}}</p>
    <p><a class="btn btn-primary" href="{{loginurl}}">{{#str}} stopped:again, factor_oksigeniaaty {{/str}}</a></p>
</div>
