{{!
    @template factor_oksigeniaaty/login

    The sign-in screen: the number to tap on the phone while it waits, or why there is none.

    Example context (json):
    {
        "code": 42,
        "waiting": true,
        "checkurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/check.php?r=1&sesskey=x",
        "expired": false,
        "againurl": "https://example.com/admin/tool/mfa/auth.php?factorname=oksigeniaaty&oksigeniaatyagain=1&sesskey=x",
        "problem": ""
    }
}}
<div class="factor-oksigeniaaty-login"{{#waiting}} data-oksigeniaaty-check="{{checkurl}}"{{/waiting}}>
    {{#waiting}}
    <p class="factor-oksigeniaaty-code" aria-label="{{#str}} wait:codearia, factor_oksigeniaaty, {{code}} {{/str}}">{{code}}</p>
    <p class="factor-oksigeniaaty-status" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        {{#str}} wait, factor_oksigeniaaty {{/str}}
    </p>
    {{/waiting}}
    {{#expired}}
    <p role="status">{{#str}} wait:expired, factor_oksigeniaaty {{/str}}</p>
    <p><a class="btn btn-secondary" href="{{againurl}}">{{#str}} wait:again, factor_oksigeniaaty {{/str}}</a></p>
    {{/expired}}
    {{#problem}}
    <div class="alert alert-warning" role="alert">{{problem}}</div>
    {{/problem}}
</div>
