{{!
    @template factor_oksigeniaaty/login

    The sign-in screen: the number to tap on the phone while it waits, or why there is none.

    Example context (json):
    {
        "code": 42,
        "waiting": true,
        "checkurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/check.php?r=1&sesskey=x",
        "expired": false,
        "againurl": "https://example.com/admin/tool/mfa/auth.php?factorname=oksigeniaaty&oksigeniaatyagain=1&sesskey=x",
        "minutes": 3,
        "typed": false,
        "seconds": 178,
        "lefttext": "%s left to approve it on your phone.",
        "says": "{}",
        "sent": "We have sent a notice to the app on your phone.",
        "problem": "",
        "early": "",
        "reachable": true,
        "codes": true,
        "codeerror": "",
        "helpurl": "https://example.com/admin/tool/mfa/auth.php?factorname=oksigeniaaty&oksigeniaatyhelp=1&sesskey=x",
        "helpwaiting": "",
        "onlytext": "",
        "codelabel": "Recovery code",
        "codeplaceholder": "0000 0000",
        "codesummary": "No phone? Use a recovery code"
    }
}}
<div class="factor-oksigeniaaty-login"{{#waiting}} data-oksigeniaaty-check="{{checkurl}}"{{/waiting}}{{^waiting}} data-oksigeniaaty-nosubmit{{/waiting}}>
    {{#waiting}}
    <p>{{sent}}</p>
    <p class="factor-oksigeniaaty-pick">{{#typed}}{{#str}} wait:type, factor_oksigeniaaty {{/str}}{{/typed}}{{^typed}}{{#str}} wait:pick, factor_oksigeniaaty {{/str}}{{/typed}}</p>
    <p class="factor-oksigeniaaty-code"><span class="visually-hidden sr-only">{{#str}} wait:codehidden, factor_oksigeniaaty {{/str}} </span>{{code}}</p>
    <p class="factor-oksigeniaaty-status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        {{#str}} wait, factor_oksigeniaaty {{/str}}
    </p>
    <div aria-live="polite">
    {{#early}}
    <p class="factor-oksigeniaaty-early">{{early}}</p>
    {{/early}}
    </div>
    <p class="factor-oksigeniaaty-valid" data-oksigeniaaty-left="{{seconds}}"
        data-oksigeniaaty-lefttext="{{lefttext}}">{{#str}} wait:valid, factor_oksigeniaaty, {{minutes}} {{/str}}</p>
    <p class="visually-hidden sr-only" aria-live="polite" data-oksigeniaaty-says="{{says}}"></p>
    <p class="factor-oksigeniaaty-resend" data-oksigeniaaty-resend hidden>
        {{#str}} wait:resendhint, factor_oksigeniaaty {{/str}}
        <a href="{{againurl}}">{{#str}} wait:resend, factor_oksigeniaaty {{/str}}</a>
    </p>
    {{/waiting}}
    {{#expired}}
    <p role="status">{{#str}} wait:expired, factor_oksigeniaaty, {{minutes}} {{/str}}</p>
    <p><a class="btn btn-primary" href="{{againurl}}">{{#str}} wait:again, factor_oksigeniaaty {{/str}}</a></p>
    {{/expired}}
    {{#problem}}
    <div class="alert alert-warning" role="alert">{{problem}}</div>
    {{/problem}}
    {{#onlytext}}
    <p>{{onlytext}}</p>
    {{/onlytext}}
    {{#codes}}
    <details class="factor-oksigeniaaty-recovery mt-3"{{#codeerror}} open{{/codeerror}}{{^reachable}} open{{/reachable}}{{#helpwaiting}} open{{/helpwaiting}}>
        <summary><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M17 6l3 3M15 8l2 2"/></svg>{{codesummary}}</summary>
        {{#helpwaiting}}
        <p class="mt-2 mb-0" role="status">{{helpwaiting}}</p>
        {{/helpwaiting}}
        <label for="factor-oksigeniaaty-recoverycode" class="mt-2">{{codelabel}}</label>
        <input type="text" id="factor-oksigeniaaty-recoverycode" name="oksigeniaatycode" class="form-control factor-oksigeniaaty-recoverycode{{#codeerror}} is-invalid{{/codeerror}}"
            inputmode="numeric" autocomplete="one-time-code" spellcheck="false" maxlength="20" placeholder="{{codeplaceholder}}"
            {{#codeerror}}aria-describedby="factor-oksigeniaaty-recoveryerror" aria-invalid="true"{{/codeerror}}>
        {{#codeerror}}
        <div id="factor-oksigeniaaty-recoveryerror" class="invalid-feedback d-block" role="alert">{{codeerror}}</div>
        {{/codeerror}}
        <button type="submit" class="btn btn-primary mt-2" name="oksigeniaatyusecode" value="1">{{#str}} recovery:enter, factor_oksigeniaaty {{/str}}</button>
        <p class="mt-2"><small>{{#str}} recovery:once, factor_oksigeniaaty {{/str}}</small></p>
    </details>
    {{/codes}}
    {{#helpurl}}
    <p class="factor-oksigeniaaty-familyhelp mt-3"><a href="{{helpurl}}">{{#str}} familyhelp:ask, factor_oksigeniaaty {{/str}}</a></p>
    {{/helpurl}}
</div>
