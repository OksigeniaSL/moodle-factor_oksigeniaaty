{{!
    @template factor_oksigeniaaty/setup

    The page to register a phone: the QR to read with the app, the link for this same phone, the chats to join, and
    the wait until the app has done it.

    Example context (json):
    {
        "enrolid": 3,
        "qr": "data:image/png;base64,iVBORw0KGgo=",
        "samephone": "moodlemobile://link=https://example.com/admin/tool/mfa/factor/oksigeniaaty/enrol.php?c=x",
        "checkurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/check.php?e=3&sesskey=x",
        "minutes": 10,
        "chats": [{"channel": "telegram", "name": "Telegram", "url": "https://t.me/example_bot?start=x"}],
        "ownchats": [{"id": 7, "name": "Telegram · Ana", "since": "21/11/26"}],
        "unlinkurl": "https://example.com/admin/tool/mfa/factor/oksigeniaaty/unlinkchat.php",
        "sesskey": "x"
    }
}}
<div class="factor-oksigeniaaty-setup"{{#checkurl}} data-oksigeniaaty-enrolcheck="{{checkurl}}"{{/checkurl}}>
    {{#qr}}
    <p>{{#str}} setup:intro, factor_oksigeniaaty {{/str}}</p>
    <ol>
        <li>{{#str}} setup:step1, factor_oksigeniaaty {{/str}}</li>
        <li>{{#str}} setup:step2, factor_oksigeniaaty {{/str}}</li>
    </ol>
    <p class="factor-oksigeniaaty-qr"><img src="{{qr}}" alt="{{#str}} setup:qralt, factor_oksigeniaaty {{/str}}" width="220" height="220"></p>
    <p>{{#str}} setup:samephone, factor_oksigeniaaty {{/str}} <a href="{{samephone}}">{{#str}} setup:samephonelink, factor_oksigeniaaty {{/str}}</a></p>
    <p class="factor-oksigeniaaty-status" data-oksigeniaaty-enrolwait>
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        {{#str}} setup:waiting, factor_oksigeniaaty, {{minutes}} {{/str}}
    </p>
    <p class="factor-oksigeniaaty-done" data-oksigeniaaty-enroldone role="status" hidden>{{#str}} setup:registered, factor_oksigeniaaty {{/str}}</p>
    {{/qr}}
    {{^qr}}
    <p>{{#str}} setup:again, factor_oksigeniaaty {{/str}}</p>
    {{/qr}}
    {{#chats.0}}
    <p>{{#str}} setup:chats, factor_oksigeniaaty {{/str}}</p>
    <ul>
        {{#chats}}
        <li><a href="{{url}}" target="_blank" rel="noopener">{{name}}</a></li>
        {{/chats}}
    </ul>
    {{/chats.0}}
    {{#ownchats.0}}
    <p>{{#str}} setup:ownchats, factor_oksigeniaaty {{/str}}</p>
    <ul class="factor-oksigeniaaty-ownchats list-unstyled">
        {{#ownchats}}
        <li>
            <form method="post" action="{{unlinkurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="id" value="{{id}}">
                <span>{{name}}</span> <small>{{#str}} setup:since, factor_oksigeniaaty, {{since}} {{/str}}</small>
                <button type="submit" class="btn btn-link p-0 align-baseline">{{#str}} setup:remove, factor_oksigeniaaty {{/str}}</button>
            </form>
        </li>
        {{/ownchats}}
    </ul>
    {{/ownchats.0}}
</div>
